{
  "name": "@quiet/desktop",
  "productName": "Quiet",
  "author": {
    "name": "Quiet LLC",
    "email": "h@quiet.chat"
  },
  "license": "GPL-3.0-or-later",
  "build": {
    "afterSign": "scripts/notarize.js",
    "afterAllArtifactBuild": "scripts/setEnvs.js",
    "productName": "Quiet",
    "appId": "Quiet",
    "protocols": {
      "name": "electron-deep-linking",
      "schemes": [
        "quiet"
      ]
    },
    "mac": {
      "icon": "./build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "category": "public.app-category.social-networking",
      "files": [
        "dist/**/*",
        "build/icon.*",
        "package.json"
      ]
    },
    "win": {
      "icon": "./build/icon.ico",
      "target": "NSIS",
      "sign": "scripts/sign.js",
      "files": [
        "dist/**/*",
        "build/icon.*",
        "package.json"
      ]
    },
    "linux": {
      "icon": "./build/icon.png",
      "target": [
        "AppImage"
      ],
      "extraFiles": [
        {
          "from": "tor/libssl.so",
          "to": "usr/lib/libssl.so"
        },
        {
          "from": "resources/libcrypto.so.1.1",
          "to": "usr/lib/libcrypto.so.1.1"
        },
        {
          "from": "resources/libssl.so.1.1",
          "to": "usr/lib/libssl.so.1.1"
        },
        {
          "from": "resources/quiet.desktop",
          "to": "resources/quiet.desktop"
        }
      ],
      "files": [
        "dist/**/*",
        "build/icon.*",
        "package.json"
      ]
    },
    "publish": {
      "provider": "s3",
      "bucket": "test.quiet"
    },
    "extraResources": [
      "tor/**/*"
    ]
  },
  "homepage": "https://github.com/TryQuiet",
  "@comment version": "To build new version for specific platform, just replace platform in version tag to one of following linux, mac, windows",
  "version": "8.0.0",
  "description": "Decentralized team chat",
  "main": "dist/main/main.js",
  "scripts": {
    "version": "echo $npm_package_version",
    "copyBinaries": "cp -R ../../3rd-party/tor/linux/ ./tor/ && chmod 775 ./tor/tor",
    "copyBinariesDarwin": "cp -R ../../3rd-party/tor/darwin/ ./tor/ && chmod 775 ./tor/tor",
    "copyBinariesWin": "xcopy /E /I /Y ..\\..\\3rd-party\\tor\\win32 .\\tor\\",
    "pullLibs": "wget -N https://zbay-binaries.s3.us-east-2.amazonaws.com/$SOURCE_PATH/libssl.so -P ./ && chmod 775 ./libssl.so",
    "distMac:local": "npm run rmDist && export SOURCE_PATH=darwin IS_LOCAL=true && npm run copyBinariesDarwin && npm run build:dev:dist && electron-builder --mac -p never -c.mac.type=development -c.mac.identity=null",
    "dist": "npm run distMac",
    "distMac": "export SOURCE_PATH=darwin && npm run copyBinariesDarwin && npm run build:prod && electron-builder --mac",
    "distUbuntu": "export SOURCE_PATH=linux && npm run copyBinaries && npm run pullLibs && npm run build:prod && electron-builder --linux",
    "distUbuntu:qss": "export SOURCE_PATH=linux && npm run copyBinaries && npm run pullLibs && npm run build:prod && electron-builder --linux",
    "distwin": "export SOURCE_PATH=win32 && npm run copyBinariesWin && npm run build:prod && electron-builder --win",
    "lint:no-fix": "eslint --ext .jsx,.js,.ts,.tsx ./src/",
    "lint": "eslint src --ext .ts,.tsx --config .eslintrc.js --fix",
    "lint:cypress": "eslint src/**/*.cy.{ts,tsx} --config .eslintrc.cypress.js",
    "lint:all": "npm run lint && npm run lint:cypress",
    "lint-staged": "lint-staged --no-stash",
    "type-check": "tsc -p tsconfig.build.json --noEmit",
    "test": "TZ=UTC LOG_TO_FILE=false jest --runInBand",
    "test:watch": "TZ=UTC LOG_TO_FILE=false jest --watchAll",
    "rtl-test": "TZ=UTC LOG_TO_FILE=false jest ./src/rtl-tests",
    "cypress:open": "cypress open --component",
    "cypress:run": "cypress run --component",
    "cypress:run:ci": "cypress install --force && cypress run --component",
    "prepare": "npm run webpack:configtest:dev && npm run webpack:configtest:prod && npm run build:main && npm run build:prepare",
    "webpack": "webpack",
    "webpack:configtest:dev": "webpack configtest webpack/webpack.config.renderer.dev.js",
    "webpack:configtest:prod": "webpack configtest webpack/webpack.config.renderer.prod.js",
    "build": "concurrently \"npm run build:main\" \"npm run build:renderer\"",
    "build:prod": "concurrently \"npm run build:main\" \"npm run build:renderer:prod\"",
    "build:dev": "concurrently \"npm run build:main\" \"npm run build:renderer\"",
    "build:dev:dist": "concurrently \"npm run build:main\" \"npm run build:renderer:prod\"",
    "build:main": "tsc -p tsconfig.build.json",
    "build:renderer": "webpack --config webpack/webpack.config.renderer.dev.js",
    "build:renderer:prod": "webpack --config webpack/webpack.config.renderer.prod.js",
    "build:prepare": "tsc -p tsconfig.build.prepare.json",
    "postBuild": "node scripts/postBuild.js",
    "prestart": "npm run build:main",
    "start": "npm run start:renderer",
    "start:main": "electron .",
    "start:renderer": "webpack-dev-server --config webpack/webpack.config.renderer.dev.js",
    "storybook": "export NODE_OPTIONS=--openssl-legacy-provider && start-storybook -p 6006",
    "build-storybook": "export NODE_OPTIONS=--openssl-legacy-provider && build-storybook",
    "chromatic": "npx chromatic --exit-zero-on-changes=false",
    "rmDist": "rimraf dist/",
    "copyFonts": "cp src/renderer/fonts/* dist/main",
    "setMainEnvs": "node scripts/setMainEnvs.js"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "1.39.0",
    "@electron/remote": "^2.1.3",
    "@quiet/common": "^2.0.2-alpha.1",
    "@quiet/logger": "^2.0.2-alpha.0",
    "@quiet/node-common": "^4.0.3",
    "@quiet/types": "^2.0.2-alpha.1",
    "backend-bundle": "^2.0.1-alpha.4",
    "electron-context-menu": "^3.6.1",
    "electron-debug": "^3.2.0",
    "electron-localshortcut": "^3.2.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^5.0.1",
    "get-port": "^5.1.1",
    "keymirror": "0.1.1",
    "libsodium-wrappers-sumo": "0.7.15",
    "luxon": "^3.4.4",
    "pkijs": "^3.0.8",
    "react-inlinesvg": "^4.3.0",
    "react-markdown": "^6.0.3",
    "react-qr-code": "^2.0.11",
    "react-select": "^5.10.2",
    "remark-gfm": "^1.0.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@cypress/react18": "2.0.0",
    "@electron/notarize": "2.1.0",
    "@emotion/react": "~11.14.0",
    "@emotion/styled": "~11.14.1",
    "@mui/icons-material": "^5.10.15",
    "@mui/material": "~5.10.15",
    "@quiet/eslint-config": "^2.0.2-alpha.0",
    "@quiet/identity": "^2.0.2-alpha.2",
    "@quiet/state-manager": "^2.0.2-alpha.3",
    "@redux-saga/types": "^1.1.0",
    "@reduxjs/toolkit": "^1.9.1",
    "@storybook/addon-essentials": "^6.5.16",
    "@storybook/addon-links": "^6.5.16",
    "@storybook/builder-webpack5": "^6.5.16",
    "@storybook/manager-webpack5": "^6.5.16",
    "@storybook/react": "^6.5.14",
    "@storybook/testing-react": "^1.3.0",
    "@testing-library/dom": "^8.19.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/electron-localshortcut": "^3.1.3",
    "@types/isomorphic-fetch": "0.0.35",
    "@types/jest": "^26.0.14",
    "@types/keymirror": "^0.1.1",
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/lodash": "^4.14.169",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20",
    "@types/ps-node": "^0.1.3",
    "@types/ramda": "^0.27.31",
    "@types/react": "^18.0.25",
    "@types/react-copy-to-clipboard": "^5.0.1",
    "@types/react-dom": "~18.0.9",
    "@types/react-router": "^5.1.8",
    "@types/react-router-dom": "^5.1.6",
    "@types/react-virtualized": "^9.21.13",
    "@types/redux-actions": "^2.6.1",
    "@types/redux-debounced": "^0.2.19",
    "@types/tmp": "^0.2.3",
    "chromatic": "^6.4.3",
    "classnames": "^2.3.1",
    "concurrently": "^4.1.0",
    "country-region-data": "^1.4.7",
    "css-loader": "^6.7.2",
    "cypress": "^13.17.0",
    "cypress-storybook": "0.5.1",
    "electron": "^32",
    "electron-builder": "^23.6.0",
    "electron-devtools-installer": "^3.1.1",
    "electron-store": "^8.2.0",
    "electron-store-webpack-wrapper": "^0.0.2",
    "emoji-picker-react": "^4.12.2",
    "enzyme": "^3.8.0",
    "enzyme-to-json": "^3.3.5",
    "factory-girl": "5.0.4",
    "file-loader": "^6.2.0",
    "history": "^4.10.1",
    "html-webpack-plugin": "^5.5.0",
    "identity-obj-proxy": "^3.0.0",
    "immer": "^9.0.6",
    "jdenticon": "^3.2.0",
    "jest": "^26.6.3",
    "jest-each": "^27.2.4",
    "js-yaml": "4.1.0",
    "lint-staged": "^15.2.2",
    "local-cypress": "1.2.6",
    "mathjax-full": "^3.2.2",
    "node-polyfill-webpack-plugin": "^2.0.1",
    "ramda": "^0.26.1",
    "rc-scrollbars": "^1.1.5",
    "react": "18.3.1",
    "react-alice-carousel": "^1.15.3",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.41.3",
    "react-redux": "^8.0.5",
    "react-resize-detector": "^7.1.2",
    "react-router-dom": "^6.4.3",
    "react-virtualized": "npm:@enykeev/react-virtualized@9.22.4-mirror.1",
    "redux": "^4.1.2",
    "redux-actions": "^2.6.4",
    "redux-debounced": "^0.5.0",
    "redux-devtools-extension": "^2.13.8",
    "redux-persist": "^6.0.0",
    "redux-persist-electron-storage": "^2.1.0",
    "redux-promise-middleware": "^5.1.1",
    "redux-saga": "^1.1.3",
    "redux-saga-test-plan": "^4.0.3",
    "redux-thunk": "^2.3.0",
    "reselect": "^4.1.5",
    "socket.io-mock": "^1.3.2",
    "source-map-loader": "^4.0.1",
    "style-loader": "^3.3.1",
    "svg-inline-loader": "^0.8.2",
    "tmp": "0.2.1",
    "ts-jest": "^26.5.2",
    "ts-loader": "^9.5.4",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typed-redux-saga": "^1.3.1",
    "typeface-roboto": "0.0.54",
    "typescript": "^4.9.5",
    "unicode-emoji-json": "^0.8.0",
    "webpack": "^5.105.3",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "websocket": "^1.0.32"
  },
  "overrides": {
    "@babel/runtime": "7.26.10",
    "yaml": "1.10.3"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/src/shared/setupTests.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest",
      "node_modules/(@react-dnd|react-dnd|react-dnd-html5-backend|dnd-core|)/.+\\.(j|t)sx?$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "<rootDir>/node_modules/(?!@react-dnd.*/|react-dnd./*|react-dnd-html5-backend/.*|dnd-core./*)"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/src/shared/testing/fileMock.ts",
      "\\.(scss|css|less)$": "identity-obj-proxy"
    },
    "testRegex": "src/.*\\.test\\.(t|j)sx?$",
    "snapshotSerializers": [
      "enzyme-to-json/serializer"
    ],
    "testPathIgnorePatterns": [
      "node_modules/",
      "distPrepare/"
    ]
  },
  "engines": {
    "node": "20.20.1",
    "npm": "10.8.2"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": "npm run lint:no-fix"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
