# Node environment
COLORIZE=true
QSS_ALLOWED=true
QSS_ENDPOINT=wss://qss-dev.quiet-services.app
QPS_ALLOWED=true
LOG_TO_FILE=true
ENVFILE=.env.staging
DEBUG=state-manager*:verbose,desktop*:verbose,utils*:verbose,identity*:verbose,backend*:verbose,-backend:auth:cryptoService*,-backend:Tor*,-backend:TimedQueue*
MINIFY_TRACE_LOGS=true
NETWORK_LOGGING=false
