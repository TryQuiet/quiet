# Node environment
NODE_ENV=development
SHOULD_RUN_BACKEND_WORKER=true
COLORIZE=false
QSS_ALLOWED=false
FOREGROUND_PUSH_NOTIFICATIONS_ALLOWED=true
QSS_ENDPOINT=ws://127.0.0.1:3003
NETWORK_LOGGING=false

# Detox cannot drive Android's system photo picker, so this build answers the profile-photo picker
# itself, with the file e2e/profile-photo.test.js puts in the app's cache. Named like the picker's
# own temp copies, which is the shape that crashed the backend.
#
# This file exists ONLY so that hook stays out of .env.e2e, which is what we hand to real devices —
# a build made from that file opened no picker at all, because the hook answered first.
E2E_PROFILE_PHOTO_NAME=e2e-profile-photo.jpg
