MIN_SUPPORTED_IPHONEOS_VERSION = '17.1'

require_relative '../node_modules/react-native/scripts/react_native_pods'

platform :ios, MIN_SUPPORTED_IPHONEOS_VERSION
use_modular_headers!

install! 'cocoapods', :deterministic_uuids => false,
  :parallel_pod_downloads => true,
  :parallel_pod_download_thread_pool_size => 40

# React native 0.76 defaults to using new architecture
# Disable New Architecture
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

target 'Quiet' do
  use_frameworks! :linkage => :static
  config = use_native_modules!

  pod 'Tor', podspec: 'https://raw.githubusercontent.com/iCepa/Tor.framework/v405.9.1/Tor.podspec'
  pod 'FirebaseCore', '~> 10.20.0'
  pod 'FirebaseMessaging', '~> 10.20.0'
  pod 'FirebaseInstallations', '~> 10.20.0'

  use_react_native!(:path => config[:reactNativePath],)

  target 'QuietTests' do
    inherit! :complete
    # Pods for testing
  end


  # Make all the other frameworks into static frameworks by overriding the static_framework? function to return true
  pre_install do |installer|
    installer.pod_targets.each do |target|
      # Make some targets static as they throw errors if not
      if target.name.eql?('RNScreens') || target.name.eql?('react-native-image-picker') or target.name.eql?('RNCClipboard')
        def target.build_type;
          Pod::BuildType.static_library
        end
      end
    end
  end



  post_install do |installer|
    react_native_post_install(installer)

    # Inject Quiet.xcconfig into Pods xcconfigs so DEVELOPMENT_TEAM and APP_BUNDLE_ID
    # are sourced from there (with optional LocalDev.xcconfig override) instead of
    # being hardcoded in project.pbxproj.
    ['debug', 'release'].each do |cfg|
      path = "#{installer.sandbox.root}/Target Support Files/Pods-Quiet/Pods-Quiet.#{cfg}.xcconfig"
      content = File.read(path)
      unless content.include?('#include "../../../Quiet.xcconfig"')
        File.open(path, 'a') { |f| f.puts '#include "../../../Quiet.xcconfig"' }
      end
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)', '_LIBCPP_ENABLE_CXX17_REMOVED_UNARY_BINARY_FUNCTION']
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = MIN_SUPPORTED_IPHONEOS_VERSION
        config.build_settings['TARGETED_DEVICE_FAMILY'] = '1' # iphone only, iphone and ipad is '1,2'
        config.build_settings["ONLY_ACTIVE_ARCH"] = "YES"
      end
    end
  end
end

target 'QuietNotificationServiceExtension' do
  use_frameworks! :linkage => :static
  pod 'Sodium'
end
