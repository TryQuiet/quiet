MIN_SUPPORTED_IPHONEOS_VERSION = '17.1'

require_relative '../node_modules/react-native/scripts/react_native_pods'
require_relative '../scripts/react-native-app-plists'

QuietReactNativeAppPlists.install!(NewArchitectureHelper)

platform :ios, MIN_SUPPORTED_IPHONEOS_VERSION
use_modular_headers!

install! 'cocoapods', :deterministic_uuids => false,
  :parallel_pod_downloads => true,
  :parallel_pod_download_thread_pool_size => 40

# Use Fabric and the bridgeless runtime with legacy native module interop.
ENV['RCT_NEW_ARCH_ENABLED'] = '1'

# Host-less logic tests for the notification service extension code. Kept outside the
# app target so they build for the simulator without the app (the Tor pod is device-only).
target 'QuietTests' do
  use_frameworks! :linkage => :static
  pod 'Sodium'
end

target 'Quiet' do
  use_frameworks! :linkage => :static
  config = use_native_modules!

  pod 'Tor', podspec: 'https://raw.githubusercontent.com/iCepa/Tor.framework/v405.9.1/Tor.podspec'
  pod 'FirebaseCore', '~> 10.20.0'
  pod 'FirebaseMessaging', '~> 10.20.0'
  pod 'FirebaseInstallations', '~> 10.20.0'

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :hermes_enabled => true
  )



  target 'QuietAppTests' do
    inherit! :complete
  end

  # Make all the other frameworks into static frameworks by overriding the static_framework? function to return true
  pre_install do |installer|
    installer.pod_targets.each do |target|
      # Make some targets static as they throw errors if not
      if target.name.eql?('RNScreens') || target.name.eql?('react-native-image-picker') or target.name.eql?('RNCClipboard')
        def target.build_type;
          Pod::BuildType.static_library
        end
      end
    end
  end



  post_install do |installer|
    react_native_post_install(installer, config[:reactNativePath])

    # Workaround for https://github.com/TryQuiet/quiet/issues/3452
    #
    # React Native 0.77 pins the `fmt` pod to 11.0.2. Apple clang 21 (Xcode 26.4+,
    # which is what the macos-26 runner image now ships) is stricter about requiring
    # the call site of a `consteval` function to itself be a constant expression, so
    # fmt 11.0.2's own `FMT_STRING(...)` uses inside `format-inl.h` no longer compile:
    #
    #   error: call to consteval function
    #   'fmt::basic_format_string<...>::basic_format_string<FMT_COMPILE_STRING, 0>'
    #   is not a constant expression
    #
    # See fmtlib/fmt#4740. fmt's `FMT_USE_CONSTEVAL` is defined unconditionally in
    # base.h, so `-DFMT_USE_CONSTEVAL=0` / `-DFMT_CONSTEVAL=` cannot switch it off.
    # The supported lever is the language standard: base.h disables consteval when
    # `__cpp_lib_is_constant_evaluated` is unavailable, i.e. below C++20.
    #
    # The fmt pod compiles exactly one translation unit (src/format.cc), so building
    # just that target as C++17 turns fmt's format-string checking from compile-time
    # into run-time for fmt's own internal, fixed format literals, and changes nothing
    # else. Every other pod (folly, the React-* pods, our own targets) keeps C++20 and
    # keeps compile-time checking of the format strings it writes.
    #
    # Remove once React Native ships an fmt release containing the upstream fix.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'fmt'
      target.build_configurations.each do |config|
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
      end
    end

    # Inject Quiet.xcconfig into Pods xcconfigs so DEVELOPMENT_TEAM and APP_BUNDLE_ID
    # are sourced from there (with optional LocalDev.xcconfig override) instead of
    # being hardcoded in project.pbxproj.
    ['debug', 'release'].each do |cfg|
      path = "#{installer.sandbox.root}/Target Support Files/Pods-Quiet/Pods-Quiet.#{cfg}.xcconfig"
      content = File.read(path)
      unless content.include?('#include "../../../Quiet.xcconfig"')
        File.open(path, 'a') { |f| f.puts '#include "../../../Quiet.xcconfig"' }
      end
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)', '_LIBCPP_ENABLE_CXX17_REMOVED_UNARY_BINARY_FUNCTION']
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = MIN_SUPPORTED_IPHONEOS_VERSION
        config.build_settings['TARGETED_DEVICE_FAMILY'] = '1' # iphone only, iphone and ipad is '1,2'
        config.build_settings["ONLY_ACTIVE_ARCH"] = "YES"
      end
    end
  end
end

target 'QuietNotificationServiceExtension' do
  use_frameworks! :linkage => :static
  pod 'Sodium'
end
