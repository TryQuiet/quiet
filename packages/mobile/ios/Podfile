require_relative '../node_modules/react-native/scripts/react_native_pods'

# Specifically link these targets @ runtime (things which'd mandate use_frameworks! w/out static linkage)
BUILD_AS_DYNAMIC_FRAMEWORK = ['Tor']
MIN_SUPPORTED_IPHONEOS_VERSION = '17.1'
platform :ios, MIN_SUPPORTED_IPHONEOS_VERSION
# Since 0.76, RN enables "new architecture" by default. explicitly disable since Quiet doesn't use it yet 
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

install! 'cocoapods', :deterministic_uuids => false,
  :parallel_pod_downloads => true,
  :parallel_pod_download_thread_pool_size => 40
use_frameworks! :linkage => :static

target 'Quiet' do

  config = use_native_modules!
  pod 'Tor', '~> 408'
  use_react_native!(:path => config[:reactNativePath])

  target 'QuietTests' do # pods for ios test suite go here...
    inherit! :complete
  end
    
  pre_install do |installer|
    statically_linked = []
    installer.pod_targets.each do |target|
      if BUILD_AS_DYNAMIC_FRAMEWORK.include? target.name
        def target.build_type;
          Pod::BuildType.dynamic_framework
        end
      else
        statically_linked.push(target.name)
      end
    end
    puts "\n\t👩‍❤️‍👩👩‍❤️‍👩👩‍❤️‍👩 Dynamically Linking #{BUILD_AS_DYNAMIC_FRAMEWORK.length} Targets:\n\t#{BUILD_AS_DYNAMIC_FRAMEWORK.inspect}"
    puts "\n\t⛓️⛓️⛓️ Statically Linking #{statically_linked.length} Targets:\n\t#{statically_linked.inspect}\n\n"
  end

  post_install do |installer|
    react_native_post_install(installer)
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)', '_LIBCPP_ENABLE_CXX17_REMOVED_UNARY_BINARY_FUNCTION']
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = MIN_SUPPORTED_IPHONEOS_VERSION
        config.build_settings['TARGETED_DEVICE_FAMILY'] = '1' # iphone only, iphone and ipad is '1,2'
      end
    end
  end
end
