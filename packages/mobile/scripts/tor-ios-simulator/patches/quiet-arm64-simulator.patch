 #!/bin/sh
 
 set -e
+
+# Darwin ar extracts archive symbol indexes as ordinary files. Re-archiving those
+# files produces duplicate __.SYMDEF members rejected by modern Apple linkers.
+# Apple libtool combines the input archives while generating one fresh index.
+if [ "$(uname -s)" = Darwin ]; then
+    quiet_archive_target=$1
+    shift
+    exec xcrun libtool -static -o "$quiet_archive_target" "$@"
+fi
 
 TMPDIR="$(mktemp -d -t tor_lib_combining.XXXXXX)"
 ORIGDIR="$(pwd)"
