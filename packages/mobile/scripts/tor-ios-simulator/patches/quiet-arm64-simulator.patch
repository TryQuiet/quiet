+#!/bin/bash
+# This isolated source build is deliberately restricted to the missing simulator slice.
+set -eo pipefail
+case "${QUIET_TOR_BUILD_JOBS:-1}" in 1|2) ;; *) echo "QUIET_TOR_BUILD_JOBS must be 1 or 2" >&2; exit 1 ;; esac
+export QUIET_TOR_BUILD_JOBS="${QUIET_TOR_BUILD_JOBS:-1}"
+export MAKEFLAGS="-j${QUIET_TOR_BUILD_JOBS}"
+make() { command make -j"${QUIET_TOR_BUILD_JOBS}" "$@"; }
+if [[ "${PLATFORM_NAME:-}" != iphonesimulator || "${ARCHS:-}" != arm64 ]]; then
+    echo "This preparation only builds arm64 iOS Simulator; device artifacts must remain unchanged." >&2
+    exit 1
+fi
+: "${SDKROOT:?Xcode must provide the simulator SDKROOT}"
+: "${IPHONEOS_DEPLOYMENT_TARGET:?Xcode must provide the deployment target}"
+QUIET_TOR_TARGET_FLAGS="-target arm64-apple-ios${IPHONEOS_DEPLOYMENT_TARGET}-simulator -isysroot ${SDKROOT}"
+export PATH="/opt/homebrew/bin:/opt/homebrew/opt/gettext/bin:${PATH}"
+export LIBTOOLIZE=glibtoolize
+# Bitcode was removed from modern Xcode. Never inherit obsolete embed-bitcode flags.
+BITCODE_CFLAGS=""
