{
  "name": "@quiet/mobile",
  "version": "6.4.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noEmit",
    "storybook-android": "ENVFILE=.env.storybook react-native run-android --mode=storybookDebug --appIdSuffix=storybook.debug",
    "storybook-ios": "ENVFILE=.env.storybook react-native run-ios",
    "android": "ENVFILE=.env.development react-native run-android --mode=standardDebug --appIdSuffix=debug",
    "ios": "ENVFILE=.env.development react-native run-ios",
    "start": "react-native start",
    "test": "TZ=UTC jest --testPathIgnorePatterns=\"./e2e\"",
    "lint:no-fix": "eslint --ext .jsx,.js,.ts,.tsx ./src/",
    "lint": "npm run lint:no-fix -- --fix",
    "lint-ci": "npm run lint:no-fix",
    "lint-staged": "lint-staged --no-stash",
    "gen": "plop",
    "prepare-backend-assets": "mkdir -p ./nodejs-assets/nodejs-project && cp ../backend/lib/bundle.cjs ./nodejs-assets/nodejs-project/bundle.cjs",
    "patch-react-native-file-logger": "patch -f -p0 --forward --binary < ./patch/rnfl/build.gradle.patch || true && patch -f -p0 --forward --binary < ./patch/rnfl/AndroidManifest.xml.patch || true",
    "patch-state-manager": "node -e \"if (process.env.NODE_ENV !== 'production'){process.exit(1)} \" || patch -f -d ../state-manager -p0 < ./factory-girl.patch || true",
    "patch-react-native": "patch -f -p0 --forward --binary < ./react-native.patch || true",
    "patch-webview-crypto": "patch -f -p0 --forward --binary < ./react-native-webview-crypto.patch || true",
    "override-dlopen": "cd ./nodejs-assets/nodejs-project && cp ../override-dlopen-paths-preload.js ./ && cp ../override-dlopen-paths-data.json ./",
    "prepare": "npm run prepare-backend-assets && npm run override-dlopen && npm run patch-react-native-file-logger && npm run patch-state-manager && npm run patch-react-native && npm run patch-webview-crypto && npm run build",
    "version": "react-native-version --skip-tag"
  },
  "dependencies": {
    "@hcaptcha/react-native-hcaptcha": "^2.1.0",
    "@peculiar/webcrypto": "^1.4.3",
    "@quiet/backend": "^2.0.3-alpha.5",
    "@quiet/common": "^2.0.2-alpha.1",
    "@quiet/identity": "^2.0.2-alpha.2",
    "@quiet/logger": "^2.0.2-alpha.0",
    "@quiet/state-manager": "^2.0.2-alpha.3",
    "@quiet/types": "^2.0.2-alpha.1",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-navigation/native": "^6.0.0",
    "@react-navigation/native-stack": "^6.9.0",
    "@react-navigation/core" : "^6.4.17",
    "@reduxjs/toolkit": "^1.9.1",
    "@ronradtke/react-native-markdown-display": "^8.1.0",
    "big-integer": "^1.6.52",
    "buffer": "^6.0.3",
    "events": "^1.1.1",
    "fast-text-encoding": "^1.0.6",
    "i18next": "^20.2.2",
    "jdenticon": "^3.2.0",
    "loadash": "^1.0.0",
    "luxon": "^3.4.4",
    "pkijs": "3.0.15",
    "pvutils": "^1.0.17",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-i18next": "^11.8.15",
    "react-intl": "^6.6.6",
    "react-linkify": "^1.0.0-alpha",
    "react-native": "0.74.7",
    "react-native-blob-util": "^0.22.2",
    "react-native-config": "1.5.7",
    "react-native-device-info": "14.0.4",
    "react-native-document-picker": "^9.1.0",
    "react-native-fast-image": "8.6.3",
    "react-native-file-logger": "0.7.1",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "2.21.2",
    "react-native-image-picker": "8.2.1",
    "react-native-level-fs": "^3.0.1",
    "react-native-mathjax-html-to-svg": "^1.1.0",
    "react-native-popup-menu": "^0.18.0",
    "react-native-progress": "5.0.1",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-safe-area-context": "5.6.1",
    "react-native-screens": "4.5.0",
    "react-native-share": "^10.2.1",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "git+https://github.com/charpeni/react-native-url-polyfill.git#f432de38c370b45e99404eb46f081f390876726d",
    "react-native-webview": "^13.12.5",
    "react-native-webview-crypto": "0.0.27",
    "react-redux": "^7.2.9",
    "readable-stream": "^3.6.0",
    "redux-persist": "^6.0.0",
    "redux-persist-filesystem-storage": "^4.2.0",
    "redux-saga": "^1.1.3",
    "rn-nodeify": "^10.3.0",
    "socket.io-client": "^4.8.1",
    "stream-browserify": "^3.0.0",
    "styled-components": "^5.3.0",
    "typed-redux-saga": "^1.3.1"
  },
  "overrides": {
    "react": "18.2.0"
  },
  "peerDependencies": {
    "react-native-randombytes": "git+https://github.com/siepra/react-native-randombytes.git#5a6dff9e340f70cabe3e1561cc2ff19671b0af49"
  },
  "devDependencies": {
    "@babel/core": "^7.24.5",
    "@babel/plugin-transform-flow-strip-types": "^7.24.1",
    "@babel/plugin-transform-private-methods": "^7.24.1",
    "@babel/preset-env": "^7.24.5",
    "@babel/runtime": "^7.24.5",
    "@localfirst/auth": "file:../../3rd-party/auth/packages/auth/dist",
    "@quiet/eslint-config": "^2.0.2-alpha.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/cli-platform-android": "^12.3.4",
    "@react-native-community/eslint-config": "^2.0.0",
    "@react-native-community/push-notification-ios": "^1.11.0",
    "@react-native/babel-preset": "0.74.89",
    "@react-native/gradle-plugin": "0.74.89",
    "@react-native/metro-config": "0.74.89",
    "@react-native/assets-registry": "0.74.89",
    "@storybook/addon-actions": "^6.5.16",
    "@storybook/addon-controls": "^6.5.16",
    "@storybook/addon-ondevice-actions": "^6.5.3",
    "@storybook/addon-ondevice-controls": "^6.5.3",
    "@storybook/react-native": "^6.5.4-alpha.0",
    "@testing-library/jest-native": "^5.4.2",
    "@testing-library/react-native": "^13.3.3",
    "@tsconfig/react-native": "^2.0.2",
    "@types/chalk": "^2.2.0",
    "@types/jest": "^29.0.0",
    "@types/lodash": "4.17.0",
    "@types/luxon": "^3.4.2",
    "@types/react": "^18.0.25",
    "@types/react-linkify": "^1.0.4",
    "@types/react-test-renderer": "19.1.0",
    "@types/styled-components": "^5.1.9",
    "@types/styled-components-react-native": "^5.2.1",
    "babel-jest": "^29.0.0",
    "chalk": "^4.1.1",
    "detox": "^20.17.1",
    "emotion-theming": "^10.0.19",
    "factory-girl": "^5.0.4",
    "jest": "^29.0.0",
    "lint-staged": "^15.2.2",
    "node-libs-react-native": "^1.2.1",
    "nodejs-mobile-gyp": "0.3.1",
    "plop": "^2.7.4",
    "react-native-version": "^4.0.0",
    "react-test-renderer": "19.1.1",
    "redux-saga-test-plan": "^4.0.1",
    "run-script-os": "1.1.6",
    "socket.io-mock": "^1.3.2",
    "typescript": "^4.9.5",
    "wait-for-expect": "^3.0.2"
  },
  "react-native": {
    "fs": "react-native-level-fs"
  },
  "browser": {
    "fs": "react-native-level-fs"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/codegen/",
      "__snapshots__"
    ],
    "setupFiles": [
      "./src/setupTests.tsx",
      "./node_modules/react-native-gesture-handler/jestSetup.js"
    ],
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect"
    ],
    "testRegex": "src/.*\\.test\\.(t|j)sx?$"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": "npm run lint:no-fix"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
