{
  "name": "@quiet/notification-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.19.0", "npm": ">=10" },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:full-loop": "node --import tsx --test --test-concurrency=1 full-loop.test.mjs",
    "test:onboarding": "node --import tsx --test --test-concurrency=1 onboarding.test.mjs",
    "server": "appium --address 127.0.0.1 --port 4725 --log-level warn"
  },
  "devDependencies": {
    "appium": "3.7.0",
    "appium-uiautomator2-driver": "8.6.3",
    "appium-xcuitest-driver": "12.12.1",
    "tsx": "4.20.6",
    "webdriverio": "9.31.7"
  }
}
