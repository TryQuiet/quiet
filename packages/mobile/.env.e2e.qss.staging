# Appium provider lane against deployed staging QSS. Provider keys remain on QSS.
NODE_ENV=development
IS_E2E=true
SHOULD_RUN_BACKEND_WORKER=true
COLORIZE=false
QSS_ALLOWED=true
QPS_ALLOWED=true
FOREGROUND_PUSH_NOTIFICATIONS_ALLOWED=true
QSS_ENDPOINT=wss://qss-dev.quiet-services.app
NETWORK_LOGGING=false
